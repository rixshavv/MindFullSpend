# Copy this file to .env and replace the passwords and JWT secret before deployment.
MYSQL_DATABASE=smart_expense
MYSQL_USER=smart_app
MYSQL_PASSWORD=replace_with_a_long_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password

# Base64-encoded random secret. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=U3BlbmRXaXNlLWxvY2FsLWRldi1rZXktY2hhbmdlLW1lLTIwMjY=
JWT_EXPIRATION_MINUTES=1440

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
